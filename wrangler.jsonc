{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinebox-kanban",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-26",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },

  "vars": {
    "APP_NAME": "Cline Kanban",
    "KANBAN_CONTAINER_HOST": "localhost",
    "KANBAN_CONTAINER_PORT": "3484",
    "ENVIRONMENT": "production"
  },

  "containers": [
    {
      "binding": "KANBAN_SERVICE",
      "image": "cline/kanban:latest",
      "port": 3484,
      "cpu": 2,
      "memory": "4GB"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clinebox-kanban-db",
      "database_id": ""
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KANBAN_KV",
      "id": ""
    }
  ],

  "routes": [
    {
      "pattern": "kanban.clinebox.dev",
      "zone_name": "clinebox.dev",
      "custom_domain": true
    }
  ]
}
